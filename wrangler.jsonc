{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ball-battle",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  // The SPA is served from Workers static assets; only the API reaches the Worker.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "ball.contextudio.com", "custom_domain": true }],
  // Keep the *.workers.dev URL alongside the custom domain.
  "workers_dev": true,
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      // One instance per online room (keyed by room code): seats, picks, series score, battle clock.
      { "name": "ROOMS", "class_name": "Room" },
      // One instance per signed-in user: online presence and friend invites.
      { "name": "HUBS", "class_name": "UserHub" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "UserHub"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ball-battle",
      "database_id": "feae2c3b-42cb-4e98-be8d-ee14acad28f0",
      "migrations_dir": "migrations"
    }
  ],
  // OAuth credentials are optional secrets (GITHUB_CLIENT_ID/SECRET, GOOGLE_CLIENT_ID/SECRET),
  // typed in worker/env.d.ts; a provider is offered only when both of its values are set.
  "secrets": { "required": [] },
  "ratelimits": [
    // Room creation and guest sign-up, per client IP.
    { "name": "CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ]
}
